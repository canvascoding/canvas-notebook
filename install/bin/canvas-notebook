#!/usr/bin/env bash
set -euo pipefail

CANVAS_CLI_VERSION="2026.9.2.1"
INSTALL_DIR="${CANVAS_INSTALL_DIR:-/opt/canvas-notebook}"
COMPOSE_FILE="${CANVAS_COMPOSE_FILE:-${INSTALL_DIR}/canvas-notebook-compose.yaml}"
DATA_DIR="${CANVAS_DATA_DIR:-${HOME:-/opt}/canvas-notebook-data}"
CANVAS_SWAP_ENABLED="${CANVAS_SWAP_ENABLED:-false}"
CANVAS_SWAP_SIZE="${CANVAS_SWAP_SIZE:-2G}"
CANVAS_SWAP_FILE="${CANVAS_SWAP_FILE:-/swapfile}"
CANVAS_SWAP_SWAPPINESS="${CANVAS_SWAP_SWAPPINESS:-10}"
SERVICE="${CANVAS_SERVICE:-canvas-notebook}"
IMAGE_REF="${CANVAS_IMAGE:-ghcr.io/canvascoding/canvas-notebook:latest}"

SHARED_DIR=""
CLI_BIN_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" 2>/dev/null && pwd)"
for _dir in "${CLI_BIN_DIR}/../lib/shared" "${INSTALL_DIR}/lib/shared"; do
  if [[ -f "${_dir}/output.sh" ]]; then
    SHARED_DIR="$_dir"
    break
  fi
done
unset _dir

if [[ -n "$SHARED_DIR" ]]; then
  for _lib in output utils config_json logging compose caddy swap container docker postgres ui; do
    if [[ -f "${SHARED_DIR}/${_lib}.sh" ]]; then
      # shellcheck source=/dev/null
      . "${SHARED_DIR}/${_lib}.sh"
    fi
  done
  unset _lib
  _systemd_lib="${CLI_BIN_DIR}/../lib/systemd.sh"
  if [[ ! -f "$_systemd_lib" ]]; then
    _systemd_lib="${INSTALL_DIR}/lib/systemd.sh"
  fi
  if [[ -f "$_systemd_lib" ]]; then
    # shellcheck source=/dev/null
    . "$_systemd_lib"
  fi
  unset _systemd_lib

  _fix_config_perms() {
    _secure_config_file_permissions
  }
  _fix_config_perms
  unset -f _fix_config_perms
else
  printf '✗ Canvas Notebook shared libraries not found.\n' >&2
  printf '  Run: canvas-notebook cli-update\n' >&2
  exit 1
fi

OUTPUT_JSON=false
NO_BANNER=false
for _arg in "$@"; do
  case "$_arg" in
    --json)
      OUTPUT_JSON=true
      NO_BANNER=true
      ;;
    --no-banner)
      NO_BANNER=true
      ;;
  esac
done
unset _arg

DEFAULT_HEALTH_ATTEMPTS="${CANVAS_HEALTH_MAX_ATTEMPTS:-180}"
LOG_DIR="${CANVAS_MANAGER_LOG_DIR:-/var/log/canvas-notebook}"
LOG_FILE="${LOG_DIR}/manager.log"
CANVAS_AUTO_UPDATE_ENABLED="${CANVAS_AUTO_UPDATE_ENABLED:-false}"
CANVAS_AUTO_UPDATE_SCHEDULE="${CANVAS_AUTO_UPDATE_SCHEDULE:-*-*-* 04:00:00}"

cmd="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

CMD_ARGS=()
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --json)
      OUTPUT_JSON=true
      NO_BANNER=true
      shift
      ;;
    --no-banner)
      NO_BANNER=true
      shift
      ;;
    -V|--version)
      if [[ "$OUTPUT_JSON" == "true" ]]; then
        image_build_json "$IMAGE_REF" "$(container_id)"
      else
        print_build_info "$IMAGE_REF" "$(container_id)"
      fi
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      CMD_ARGS+=("$@")
      break
      ;;
    *)
      CMD_ARGS+=("$1")
      shift
      ;;
  esac
done

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  version|-V|--version)
    if [[ "$OUTPUT_JSON" == "true" ]]; then
      image_build_json "$IMAGE_REF" "$(container_id)"
    else
      print_build_info "$IMAGE_REF" "$(container_id)"
    fi
    exit 0
    ;;
esac

config_json_init

cmd_file_for() {
  case "$1" in
    install|update) printf 'update\n' ;;
    start|restart|stop|down) printf 'lifecycle\n' ;;
    status|health|diagnose|config|ps) printf 'status\n' ;;
    logs|container-logs|manager-log|cleanup-logs) printf 'logs\n' ;;
    env) printf 'env\n' ;;
    backup) printf 'backup\n' ;;
    database) printf 'database\n' ;;
    admin) printf 'admin\n' ;;
    swap|swap-sync|swap-apply|swap-enable|swap-disable) printf 'swap\n' ;;
    caddy|caddy-reload|caddy-fix) printf 'caddy\n' ;;
    auto-update-status|auto-update-enable|auto-update-disable|auto-update-sync) printf 'auto_update\n' ;;
    cli-update) printf 'cli_update\n' ;;
    config-show|config-set|config-migrate) printf 'config_cmd\n' ;;
    *) return 1 ;;
  esac
}

cmd_file="$(cmd_file_for "$cmd" || true)"

if [[ -z "$cmd_file" ]]; then
  usage >&2
  exit 2
fi

if [[ "$NO_BANNER" != "true" ]]; then
  banner
fi

CMD_DIR="${CLI_BIN_DIR}/../lib/commands"
if [[ ! -d "$CMD_DIR" ]]; then
  CMD_DIR="${INSTALL_DIR}/lib/commands"
fi

canvas_command_requires_operation_lock() {
  local command_name="$1" subcommand="${CMD_ARGS[0]:-}"
  case "$command_name" in
    install|update|cli-update|config-set|config-migrate|start|restart|stop|down|admin|backup|cleanup-logs) return 0 ;;
    env)
      canvas_command_has_arg --sync || canvas_command_has_arg --render || canvas_command_has_arg --edit
      ;;
    database)
      [[ "$subcommand" == "prepare-postgres" || "$subcommand" == "reconcile-postgres-auth" ]]
      ;;
    service)
      [[ "$subcommand" == "install" || "$subcommand" == "uninstall" ]]
      ;;
    swap-enable|swap-disable|caddy-reload|caddy-fix|auto-update-enable|auto-update-disable|auto-update-sync) return 0 ;;
    *) return 1 ;;
  esac
}

canvas_command_has_arg() {
  local expected="$1" arg
  if [[ "${#CMD_ARGS[@]}" -eq 0 ]]; then
    return 1
  fi
  for arg in "${CMD_ARGS[@]}"; do
    [[ "$arg" == "$expected" ]] && return 0
  done
  return 1
}

if canvas_command_requires_operation_lock "$cmd"; then
  canvas_operation_lock_acquire "$cmd"
fi

pending_recovery_journal="${CANVAS_POSTGRES_RECONCILE_JOURNAL:-${INSTALL_DIR}/.postgres-auth-reconcile.json}"
if [[ -f "$pending_recovery_journal" ]] && canvas_command_requires_operation_lock "$cmd"; then
  pending_recovery_allowed=false
  case "$cmd" in
    update|start|restart|stop|cli-update) pending_recovery_allowed=true ;;
    env)
      if canvas_command_has_arg --sync || canvas_command_has_arg --edit; then
        pending_recovery_allowed=true
      fi
      ;;
    database)
      [[ "${CMD_ARGS[0]:-}" == "reconcile-postgres-auth" ]] && pending_recovery_allowed=true
      ;;
  esac
  if [[ "$pending_recovery_allowed" != "true" ]]; then
    fail "An interrupted Postgres auth reconciliation is pending. Run database reconcile-postgres-auth first."
  fi
fi
unset pending_recovery_journal pending_recovery_allowed

if [[ -f "${CMD_DIR}/${cmd_file}.sh" ]]; then
  # shellcheck source=/dev/null
  . "${CMD_DIR}/${cmd_file}.sh"
else
  fail "Command file not found: ${CMD_DIR}/${cmd_file}.sh. Run: canvas-notebook cli-update"
fi

cmd_fn="cmd_${cmd//-/_}"

if ! declare -f "$cmd_fn" >/dev/null 2>&1; then
  fail "Command '${cmd}' is defined in ${cmd_file}.sh but function ${cmd_fn}() not found"
fi

if [[ "${#CMD_ARGS[@]}" -gt 0 ]]; then
  "$cmd_fn" "${CMD_ARGS[@]}"
else
  "$cmd_fn"
fi
