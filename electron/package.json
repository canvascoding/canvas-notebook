{
  "name": "canvas-notebook-desktop",
  "version": "2026.8.27001",
  "private": true,
  "description": "Desktop shell for Canvas Notebook",
  "author": "Canvas Studios",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "main/main.mjs",
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "io.canvasstudios.notebook",
    "productName": "Canvas Notebook",
    "electronVersion": "42.6.1",
    "buildVersion": "2026.8.27.1",
    "icon": "assets/icon",
    "artifactName": "Canvas-Notebook-${buildVersion}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../dist-electron"
    },
    "npmRebuild": false,
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../docs/compliance/third-party-components.json",
        "to": "third-party-components.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "canvascoding",
        "repo": "canvas-notebook",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  }
}
